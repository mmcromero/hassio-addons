# AVISAQUI-HTTPS-001 — exemplo, NÃO ativado.
# Adicionar como arquivo nginx_proxy_default_avisaqui.conf em /share
# somente depois da homologação da aplicação, dentro do mesmo servidor SSL
# em que já existe /artesaos-piloto/.
# Não inserir chaves ou segredos neste arquivo.
location = /avisaqui {
    absolute_redirect off;
    return 308 /avisaqui/;
}
location ^~ /avisaqui/ {
    # A barra final remove /avisaqui/ antes de encaminhar ao Fastify.
    proxy_pass http://45c28620-pager-virtual:8095/;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /avisaqui;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_redirect off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 3600s;
    proxy_buffering off;
    proxy_cache off;
    client_max_body_size 3m;
}
