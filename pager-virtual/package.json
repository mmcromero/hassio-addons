{
  "name": "pager-virtual",
  "version": "0.1.20-rc.10",
  "description": "Sistema de Pager Virtual ultraleve para restaurantes e food service",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:games:browser": "node tests/games-browser-smoke.lab.mjs",
    "test:unificado": "node scripts/ci/testes-unificados-local.mjs",
    "test:unificado:web": "node scripts/ci/testes-unificados-local.mjs --perfil=web",
    "test:unificado:integrado": "node scripts/ci/testes-unificados-local.mjs --perfil=integrado",
    "test:unificado:executor": "node --test tests/testes-unificados-local.test.mjs"
  },
  "keywords": [
    "pager",
    "kds",
    "food-service",
    "restaurant",
    "sse"
  ],
  "author": "Marco Romero",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/static": "^10.1.11",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.12.8",
    "nanoid": "^5.0.6",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
